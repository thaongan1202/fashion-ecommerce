############################################################
# Environment variables for UTE PhoneHub (Template)
# Đổi tên file này thành `.env` ở root hoặc trong thư mục backend/
# trước khi chạy `docker compose up`.
############################################################

########################
# Database (Postgres)
########################
POSTGRES_USER=utephonehub
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=utephonehub_db

# Spring datasource (thường trùng với Postgres ở trên)
DB_HOST=postgres
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

########################
# Redis
########################
REDIS_HOST=redis

########################
# Mail (SMTP)
########################
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=lamngocyenvy0305@gmail.com
MAIL_PASSWORD=ovzagamckkhkmahp


########################
# Google OAuth2
########################
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

########################
# JWT
########################
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

########################
# VNPay
########################
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_RETURN_URL=http://localhost:8081/api/v1/payments/vnpay/return

########################
# Server
########################
SERVER_PORT=8081

########################
# Frontend
########################
# URL base của API backend cho frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1

# Frontend URL Configuration
FRONTEND_URL=http://localhost:3000

